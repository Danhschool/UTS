  useGpu: 0
  flashAttention: 0
  language: vi
  translateToEnglish: 0
  strategy: 0
  noContext: 1
  singleSegment: 0
  enableTokens: 0
  initialPrompt: chon toan bo quan doi cua toi, chon dan dang ranh, chon toan bo
    cung thu, di chuyen den diem a, vua di chuyen vua tan cong den diem b, tan cong
    nha chinh cua doi thu, tap trung ban vao phap su dich, dung lai ngay, giu vi
    tri tai day, tuan tra tu cong nam den mo vang, rut quan ve can cu, dan ra chong
    go o rung ben trai, mang tai nguyen ve kho ngay, xay nha dan tai vi tri nay,
    xay tuong tu doi nay den bo song, dan sua thap phong thu kia, huy xay cong trinh
    nay, huan luyen 5 cung thu, dat diem tap ket tai cong chinh, nghien cuu nang
    cap giap bo binh, len doi 2 ngay bay gio, gan dao quan nay vao nhom 1, chon nhom
    1, them don vi nay vao nhom 1, dua camera den can cu chinh, ping tai cong ben
    phai, dong minh tan cong cua chinh doi thu, dong minh ve thu nha chinh, gui cho
    toi 300 go, tam dung tran dau, tiep tuc tran dau, tang toc do game len nhanh,
    luu tran dau hien tai, toi dau hang
  stepSec: 1.5
  keepSec: 0.2
  lengthSec: 10
  updatePrompt: 1
  dropOldBuffer: 0
  useVad: 1
  tokensTimestamps: 0
  audioCtx: 0
